{
  "name": "screen-share-assistant",
  "version": "1.0.0",
  "description": "跨进程屏幕共享桌面助手 - Electron + Node.js原生模块",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "server": "node server.js",
    "build": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "electron",
    "screen-share",
    "websocket",
    "desktop"
  ],
  "author": "Screen Share Assistant",
  "license": "MIT",
  "dependencies": {
    "screenshot-desktop": "^1.15.0",
    "sharp": "^0.33.2",
    "ws": "^8.16.0",
    "express": "^4.18.2",
    "sqlite3": "^5.1.7",
    "robotjs": "^0.6.0",
    "iohook": "^0.9.3"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.screenshare.assistant",
    "productName": "ScreenShare Assistant",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
