{
  "name": "midi-analyzer",
  "version": "1.0.0",
  "description": "MIDI Music Analysis Web Application",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\" \"npm run worker\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "worker": "cd python && python worker.py worker-1",
    "worker:multi": "concurrently \"npm run worker\" \"npm run worker:2\"",
    "worker:2": "cd python && python worker.py worker-2",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "init-db": "node server/scripts/init-db.js",
    "start:prod": "concurrently \"npm run start\" \"npm run worker\"",
    "db:add-indexes": "node server/scripts/add-gin-indexes.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "python-shell": "^5.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2"
  }
}
